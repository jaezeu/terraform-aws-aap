# Copy to terraform.tfvars (git-ignored) or set these as HCP Terraform workspace
# variables. Mark the Red Hat secrets as *sensitive*.

name       = "aap-demo"
aws_region = "ap-southeast-1"

# Lock this down to your public IP(s) for anything that lives longer than a demo.
allowed_cidr_blocks = ["0.0.0.0/0"]

#---------------------------------------------------------------------------
# Red Hat credentials -- see README "Prerequisites" for where each comes from
#---------------------------------------------------------------------------
# registry.redhat.io service account (https://access.redhat.com/terms-based-registry/)
redhat_registry_username = "12345678|aap-demo"
redhat_registry_password = "eyJhbGciOi..."

# Offline token (https://access.redhat.com/management/api). Downloads the latest
# AAP installer and, with the allocation UUID below, the subscription manifest.
redhat_offline_token = "eyJhbGciOi..."

# Optional: subscription allocation UUID so AAP starts fully licensed
# (https://access.redhat.com/management/subscription_allocations).
# redhat_subscription_allocation_uuid = "7f4075b9-38ac-46e3-986d-bf481d1853be"

#---------------------------------------------------------------------------
# Optional tuning
#---------------------------------------------------------------------------
# aap_version           = "2.6"
# instance_type         = "m6i.2xlarge"
# root_volume_size_gb   = 100
# rhel_major_version    = "9"
# enable_eda            = true
# enable_automation_hub = true
# aap_admin_password    = "ChangeMe-Please-123"  # generated when omitted
# aap_hostname          = "aap.demo.example.com" # together with route53_zone_id
# route53_zone_id       = "Z0123456789ABCDEFGHIJ"
# wait_for_aap          = true
# wait_timeout_minutes  = 60

# Bring your own installer / manifest instead of the Red Hat API:
# aap_installer_s3_uri = "s3://my-bucket/ansible-automation-platform-containerized-setup-2.6-7.tar.gz"
# aap_manifest_s3_uri  = "s3://my-bucket/manifest_aap_demo.zip"

# Deploy into an existing VPC instead of creating one:
# create_vpc = false
# vpc_id     = "vpc-0123456789abcdef0"
# subnet_id  = "subnet-0123456789abcdef0"

# Any other installer inventory variable, e.g. configuration-as-code postinstall:
# extra_inventory_vars = {
#   controller_postinstall          = "true"
#   controller_postinstall_dir      = "/home/aap/postinstall"
#   controller_postinstall_repo_url = "https://github.com/org/aap-config-as-code.git"
#   controller_postinstall_repo_ref = "main"
# }
